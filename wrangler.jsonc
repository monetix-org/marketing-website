{
  // Landing de Monetix: Worker solo con archivos estáticos (sin código de servidor).
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "marketing-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "env": {
    // Ambiente dev: rama develop -> https://dev.monetix.mx
    "dev": {
      "routes": [
        {
          "pattern": "dev.monetix.mx",
          "custom_domain": true
        }
      ]
    },
    // Producción: rama main -> https://monetix.mx
    // Solo se despliega cuando la variable PROD_ENABLED del repo vale "true" (ver deploy.yml).
    "production": {
      "routes": [
        {
          "pattern": "monetix.mx",
          "custom_domain": true
        }
      ]
    }
  }
}